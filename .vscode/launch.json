{
    "version": "0.2.0",
    "configurations": [
    {
        "name": "Debug Streamlit demo",
        "type": "debugpy",
        "request": "launch",
        "module": "streamlit",
        "python": "${workspaceFolder}/venv/Scripts/python.exe",
        "cwd": "${workspaceFolder}",
        "env": {
            "PYTHONPATH": "${workspaceFolder}/src",
            "PYTHONUTF8": "1"
        },
        "args": [
            "run",
            "${workspaceFolder}/src/canasta_inteligente/application/streamlit_demo.py"
        ],
        "console": "integratedTerminal",
        "justMyCode": true
    },
        {
            "name": "Debug canasta familiar",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.application.probar_familia",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "testing person canasta",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.application.probar_persona",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug optimización dieta (Tkinter)",
            "type": "debugpy",
            "request": "launch",      
            "module": "canasta_inteligente.application.demo_dieta_tk",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
            

        },
        {
            "name": "Debug optimización dieta (consola)",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.application.demo_dieta_cli",
            "python": "${workspaceFolder}/venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUTF8": "1"
            },
            "args": [
                "--modo", "comparar",
                "--edad", "25",
                "--sexo", "hombre",
                "--peso", "70",
                "--altura", "1.70",
                "--presupuesto", "15"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug main nutrition evaluation",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.app.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal"
        },
                {
            "name": "pulp test",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.app.main",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/notebooks"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Debug CBA pipeline (con INCAP)",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.application.cba_pipeline",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--output",
                "${workspaceFolder}/data/processed/cba_catalog.pkl"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug CBA pipeline (sin INCAP)",
            "type": "debugpy",
            "request": "launch",
            "module": "canasta_inteligente.application.cba_pipeline",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--without-incap",
                "--output",
                "${workspaceFolder}/data/processed/cba_solo_precios.pkl"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
